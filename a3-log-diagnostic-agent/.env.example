# 企业采集器只在受控服务器配置，绝不要提交真实私钥。
HOST=127.0.0.1
# If exposed behind an intranet gateway, configure a token or enterprise SSO.
# A3_ACCESS_TOKEN=<long-random-token>
A3_SSH_KEY=C:\secure\id_rsa.release
A3_PORT_AGENT_PATH=C:\secure\port_a3_agent.js
A3_LOG_STORE=D:\secure-a3-logs

# 按区域补充 FRP 地址；欧服已内置。
A3_REGION_HOSTS_JSON={"cn":"<host>","hk":"<host>","jp":"<host>","us":"<host>"}

# 可选：使用外部采集器替代内置 UOP/SSH 流程。
# A3_COLLECTOR_COMMAND=C:\secure\collector.exe
# A3_COLLECTOR_ARGS_JSON=["--sn","{sn}","--output","{output}"]

